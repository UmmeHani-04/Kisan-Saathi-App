# Copy this file to .env and paste your Groq key. NEVER commit .env.
# Get a free key: https://console.groq.com/keys   (starts with gsk_)
# GROQ_API_KEY=


# Optional. Model names change over time, so check https://console.groq.com/docs/models
# Main model (better Hindi/Marathi) and a smaller backup used when the free limit is hit:
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# Optional image-capable model for crop photo guidance. If empty, the feature
# returns a clear configuration message and never fabricates a diagnosis.
GROQ_VISION_MODEL=

# Optional paid alternative, used only if GROQ_API_KEY is empty:
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

PORT=8000

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080,http://127.0.0.1:5173,http://127.0.0.1:3000

# Optional. Keep the data.gov.in API key on the backend; never expose it in VITE_* variables.
DATA_GOV_API_KEY=
# Resource ID for the selected agricultural market-price dataset.
DATA_GOV_RESOURCE_ID=579b464db66ec23bdd000001b923065284364c376199cfeb0a21bf84

# Optional. Set both values to require login for protected backend features.
FIREBASE_PROJECT_ID=
REQUIRE_LOGIN=false
